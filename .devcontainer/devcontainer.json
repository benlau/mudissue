{
  "name": "mudissue",
  "dockerComposeFile": "docker-compose.yml",
  "service": "mudissue",
  "workspaceFolder": "/workspace",
  "remoteUser": "node",
  "initializeCommand": "sh .devcontainer/scripts/write-primary-worktree-env.sh \"${localWorkspaceFolder}\"",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
