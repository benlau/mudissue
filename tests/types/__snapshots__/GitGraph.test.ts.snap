    branch FAX0111
    checkout FAX0112
    commit id: "1fb1941"
    checkout FAX0111
    commit id: "dd8375b"
    commit id: "4b8f044"
    commit id: "318fb59"
    commit id: "fed94eb""
`;

exports[`MermaidGitGraphAccessor.createFromGitGraph example02 1`] = `
"---
config:
  gitGraph:
    mainBranchName: 'pr/milestone-4'
---
gitGraph TB:
    commit id: "4af7342"
    branch FAX0112
    checkout "pr/milestone-4"
    commit id: "dd8375b"
    commit id: "4b8f044"
    commit id: "318fb59"
    commit id: "fed94eb"
    commit id: "57df994" tag: "FAX0111"
    checkout FAX0112
    commit id: "1fb1941"
    commit id: "ba71e53""
`;

exports[`MermaidGitGraphAccessor.createFromGitGraph for a linear history of root then child on main, emits commits oldest-first and sets mainBranchName from the second argument 1`] = `
"---
config:
  gitGraph:
    mainBranchName: 'master'
---
gitGraph TB:
    commit id: "root111"
    commit id: "tip1111""
`;

exports[`MermaidGitGraphAccessor.createFromGitGraph for a merge commit whose first parent is main and second is feature, emits one merge command merging from the feature branch name 1`] = `
"---
config:
  gitGraph:
    mainBranchName: 'main'
---
gitGraph TB:
    commit id: "1111111"
    branch side
    checkout main
    commit id: "2222222" tag: "mainline"
    checkout side
    commit id: "3333333" tag: "side"
    checkout main
    merge side id: "4444444" tag: "trunk""
`;

exports[`MermaidGitGraphAccessor.createFromGitGraph main-as-root 1`] = `
"---
config:
  gitGraph:
    mainBranchName: 'main'
---
gitGraph TB:
    commit id: "a"
    branch feature
    checkout feature
    commit id: "b"
    commit id: "c"
    commit id: "d""
`;

exports[`MermaidGitGraphAccessor.createFromGitGraph main-feature-root 1`] = `
"---
config:
  gitGraph:
    mainBranchName: 'main'
---
gitGraph TB:
    commit id: "a" tag: "feature2"
    branch feature1
    checkout feature1
    commit id: "b"
    commit id: "c"
    commit id: "d""
`;

