// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`MermaidGitGraphAccessor.createFromGitGraph diamond history 1`] = `
"---
config:
  gitGraph:
    mainBranchName: 'main'
---
gitGraph TB:
    commit id: "aaa2222"
    commit id: "bbb2222"
    branch "No Name 1"
    checkout "No Name 1"
    commit id: "ddd2222"
    checkout main
    merge "No Name 1" id: "ccc2222""
`;

exports[`MermaidGitGraphAccessor.createFromGitGraph example01 1`] = `
"---
config:
  gitGraph:
