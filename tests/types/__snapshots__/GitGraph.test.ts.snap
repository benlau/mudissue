exports[`MermaidGitGraphAccessor.createFromGitGraph single-line-multi-branch-same-head 1`] = `
"---
config:
  gitGraph:
    mainBranchName: 'main'
---
gitGraph TB:
    commit id: "aaa1111"
    commit id: "bbb1111"
    commit id: "ccc1111" tag: "feature""
`;

exports[`MermaidGitGraphAccessor.createFromGitGraph when a branch tip is not a graph leaf, tags that commit with the branch name (main a→b→c, feature at b) 1`] = `
"---
config:
  gitGraph:
    mainBranchName: 'main'
---
gitGraph TB:
    commit id: "aaaaaaa"
    commit id: "bbbbbbb" tag: "feature"
    commit id: "ccccccc""
`;

exports[`MermaidGitGraphAccessor.createFromGitGraph when a node holds multiple objectIds (e.g. after compress()), renders its commit id as the short oids of the first and last objects joined by '...' 1`] = `
"---
config:
  gitGraph:
    mainBranchName: 'main'
---
gitGraph TB:
    commit id: "aaaa555"
    commit id: "bbbb555...dddd555"
    commit id: "eeee555""
`;

exports[`MermaidGitGraphAccessor.createFromGitGraph when rootCommitId is missing, emits no commands even if orphan commits exist in nodes 1`] = `
"---
config:
  gitGraph:
    mainBranchName: 'main'
---
gitGraph TB:"
`;

exports[`MermaidGitGraphAccessor.createFromGitGraph when serializing to Mermaid text, prepends YAML frontmatter with mainBranchName and emits one commit line per commit in traversal order 1`] = `
"---
config:
  gitGraph:
    mainBranchName: 'master'
---
gitGraph TB:
    commit id: "root111"
    commit id: "tip1111""
`;

exports[`MermaidGitGraphAccessor.createFromGitGraph when the graph has no commits, emits no commands and names the main branch from the second argument 1`] = `
"---
config:
  gitGraph:
    mainBranchName: 'develop'
---
gitGraph TB:"
`;

exports[`MermaidGitGraphAccessor.createFromGitGraph when two branch tips share one root and there is no merge, emits main-line commits before the feature tip (topological tie-break) 1`] = `
"---
config:
  gitGraph:
    mainBranchName: 'main'
---
gitGraph TB:
    commit id: "aaaaaaa"
    branch mainline
    checkout main
    commit id: "ccccccc"
    checkout mainline
    commit id: "bbbbbbb""
`;
